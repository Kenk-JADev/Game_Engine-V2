  "events": [
    {
      "id": 1,
      "name": "Wächter Mara",
      "x": 0.0,
      "z": 4.5,
      "radius": 3.2,
      "pages": [
        {
          "conditions": {},
          "trigger": "action",
          "commands": [
            {
              "cmd": "script",
              "name": "dorf_begruessung"
            },
            {
              "cmd": "if_switch",
              "name": "kristall_aktiv",
              "value": true,
              "then": [
                {
                  "cmd": "text",
                  "lines": [
                    "Mara: Die Kristalle singen wieder.",
                    "Du hast das Dorf gerettet."
                  ]
                }
              ],
              "else": [
                {
                  "cmd": "text",
                  "lines": [
                    "Mara: Drei Kristalle trägt der Weg nach Norden.",
                    "Hol sie dir, dann öffnen sich die Tore."
                  ]
                },
                {
                  "cmd": "if_variable",
                  "name": "kristalle",
                  "op": ">=",
                  "value": 3,
                  "then": [
                    {
                      "cmd": "text",
                      "lines": [
                        "Mara: Du hast alle drei!",
                        "Mara: Ich aktiviere den Schutzkreis."
                      ]
                    },
                    {
                      "cmd": "switch",
                      "name": "kristall_aktiv",
                      "value": true
                    },
                    {
                      "cmd": "variable",
                      "name": "kristalle",
                      "add": 0
                    },
                    {
                      "cmd": "log",
                      "text": "Quest abgeschlossen: kristall_aktiv = true"
                    }
                  ],
                  "else": [
                    {
                      "cmd": "text",
                      "lines": [
                        "Mara: Noch nicht genug. Zähle sie selbst nach."
                      ]
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
